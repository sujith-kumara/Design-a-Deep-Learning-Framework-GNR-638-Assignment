    {
      "cell_type": "code",
      "source": [
        "samples_per_class = 30\n",
        "indices = []\n",
        "class_counts = {i:0 for i in range(30)}\n",
        "\n",
        "for idx,(img,label) in enumerate(train_dataset):\n",
        "    if class_counts[label] < samples_per_class:\n",
        "        indices.append(idx)\n",
        "        class_counts[label]+=1\n",
        "\n",
        "    if sum(class_counts.values()) == 900:\n",
        "        break\n",
        "\n",
        "\n",
        "probe_subset = torch.utils.data.Subset(train_dataset, indices)\n",
        "probe_loader = DataLoader(probe_subset, batch_size=32)\n"
      ],
      "metadata": {
        "id": "TCctbcaVc1hd"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "def extract_features(layer_name):\n",
        "\n",
        "    features = []\n",
        "    labels = []\n",
        "\n",
        "    with torch.no_grad():\n",
        "        for images, targets in probe_loader:\n",
        "            images = images.to(device)\n",
        "            x = images\n",
        "\n",
        "            # EfficientNet-B0 specific layer extraction\n",
        "            if layer_name == \"stem\":\n",
        "                x = model.conv_stem(x)\n",
        "            elif layer_name == \"block_3\":\n",
        "                x = model.conv_stem(x)\n",
        "                for i in range(4): # up to block 3 (indices 0, 1, 2, 3)\n",
        "                    x = model.blocks[i](x)\n",
        "            elif layer_name == \"block_6\": # Last block features\n",
        "                x = model.forward_features(x)\n",
        "\n",
        "            x = torch.flatten(x,1)\n",
        "\n",
        "            features.append(x.cpu().numpy())\n",
        "            labels.append(targets.numpy())\n",
        "\n",
        "    features = np.concatenate(features)\n",
        "    labels = np.concatenate(labels)\n",
        "\n",
        "    return features, labels"
      ],
      "metadata": {
        "id": "0-ZdsMf6c4JP"
      },
      "execution_count": null,
      "outputs": []
