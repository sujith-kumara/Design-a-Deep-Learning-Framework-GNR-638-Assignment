      "source": [
        "def add_gaussian_noise(images, sigma):\n",
        "    noise = torch.randn_like(images) * sigma\n",
        "\n",
        "    return images + noise\n"
      ],
      "metadata": {
        "id": "OQS-g545cFq0"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "\n",
        "def motion_blur(image):\n",
        "    kernel = np.zeros((9,9))\n",
        "    kernel[4,:] = np.ones(9)/9\n",
        "\n",
        "    return cv2.filter2D(image, -1, kernel)\n"
      ],
      "metadata": {
        "id": "3RfYDq8Bb-lO"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "def brightness_shift(images, factor):\n",
        "\n",
        "    return torch.clamp(images * factor, 0, 1)\n"
      ],
      "metadata": {
        "id": "_azPPUsjcL6R"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "def evaluate_with_corruption(loader, corruption, param):\n",
        "    model.eval()\n",
        "\n",
        "    correct = 0\n",
        "    total = 0\n",
        "\n",
        "    for images, labels in loader:\n",
        "        images = images.to(device)\n",
        "\n",
        "        if corruption == \"gaussian\":\n",
        "            images = add_gaussian_noise(images, param)\n",
        "        elif corruption == \"brightness\":\n",
        "            images = brightness_shift(images, param)\n",
        "\n",
        "        outputs = model(images)\n",
        "        _, preds = torch.max(outputs,1)\n",
        "\n",
        "        total += labels.size(0)\n",
        "        correct += (preds.cpu()==labels).sum().item()\n",
        "\n",
        "    return correct/total\n"
      ],
      "metadata": {
        "id": "Bd3cnoI2cOY8"
      },
      "execution_count": null,
      "outputs": []
    },
