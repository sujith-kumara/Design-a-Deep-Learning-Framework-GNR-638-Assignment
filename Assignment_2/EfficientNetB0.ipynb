    {
      "cell_type": "markdown",
      "source": [
        "##Train Linear Probe on Extracted Features"
      ],
      "metadata": {
        "id": "Ye7Bx2CGdEpr"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "def feature_norm_stats(features):\n",
        "\n",
        "    norms = np.linalg.norm(features, axis=1)\n",
        "    mean_norm = np.mean(norms)\n",
        "    std_norm = np.std(norms)\n",
        "\n",
        "    return mean_norm, std_norm\n"
      ],
      "metadata": {
        "id": "xx3uPjx7c7CB"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "def train_linear_probe(features, labels):\n",
        "\n",
        "    X_train, X_test, y_train, y_test = train_test_split(\n",
        "        features, labels, test_size=0.3, random_state=42\n",
        "    )\n",
        "\n",
        "    clf = LogisticRegression(max_iter=200)\n",
        "    clf.fit(X_train, y_train)\n",
        "    preds = clf.predict(X_test)\n",
        "    acc = accuracy_score(y_test, preds)\n",
        "\n",
        "    return acc\n"
      ],
      "metadata": {
        "id": "LQecAXRkdBGL"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "layer_results = {}\n",
        "\n",
        "for layer_name in probe_layers:\n",
        "    feats, labs = extract_features(layer_name)\n",
        "    acc = train_linear_probe(feats, labs)\n",
        "    mean_norm, std_norm = feature_norm_stats(feats)\n",
        "    layer_results[layer_name] = {\n",
        "        \"accuracy\": acc,\n",
        "        \"mean_norm\": mean_norm,\n",
        "        \"std_norm\": std_norm\n",
        "    }\n",
        "\n",
        "    print(layer_name, acc, mean_norm)\n"
