    {
      "cell_type": "markdown",
      "source": [
        "## Tranformation"
      ],
      "metadata": {
        "id": "p48wCgjM4ddY"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "train_transform = transforms.Compose([\n",
        "\n",
        "    transforms.Resize((224,224)),\n",
        "\n",
        "    transforms.RandomHorizontalFlip(),\n",
        "\n",
        "    transforms.RandomRotation(10),\n",
