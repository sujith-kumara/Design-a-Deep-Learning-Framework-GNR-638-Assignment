        "def set_seed(seed=42):\n",
        "    random.seed(seed)\n",
        "    np.random.seed(seed)\n",
        "    torch.manual_seed(seed)\n",
        "    torch.cuda.manual_seed_all(seed)\n",
        "set_seed(42)\n",
        "NUM_CLASSES = 30\n",
        "Nepochs = 30 #Backbone epoch\n",
        "Fepochs = 10 #Fine-tuning epoch\n",
        "Oepochs = 20 #Oneshot epoch"
